{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "console": {
      "()": "spectre.logging_config.ConsoleFormatter",
      "component": "web"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "console",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {"level": "INFO"},
    "config_app": {"level": "INFO"}
  },
  "root": {"level": "WARNING", "handlers": ["console"]}
}
